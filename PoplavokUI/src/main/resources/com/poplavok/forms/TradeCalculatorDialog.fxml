<?xml version="1.0" encoding="UTF-8"?>

<?import com.poplavok.forms.TickerPricePicker?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root prefWidth="560.0" spacing="8.0" type="VBox" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
    <TickerPricePicker fx:id="tickerPricePicker" />
    <Separator />
    <GridPane hgap="10.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="-Infinity" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <children>
            <Label text="Direction:" />
            <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1">
                <RadioButton fx:id="longRadioButton" minWidth="-Infinity" mnemonicParsing="false" selected="true" text="LONG (buy BASE)">
                    <toggleGroup>
                        <ToggleGroup fx:id="directionGroup" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="shortRadioButton" minWidth="-Infinity" mnemonicParsing="false" text="SHORT (sell BASE)" toggleGroup="$directionGroup" />
            </HBox>
            <Label text="Fee:" GridPane.rowIndex="1" />
            <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <RadioButton fx:id="takerRadioButton" minWidth="-Infinity" mnemonicParsing="false" selected="true" text="taker">
                    <toggleGroup>
                        <ToggleGroup fx:id="feeGroup" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="makerRadioButton" minWidth="-Infinity" mnemonicParsing="false" text="maker" toggleGroup="$feeGroup" />
                <TextField fx:id="feeTextField" prefWidth="80.0" text="0.1" />
                <Label text="\%" />
            </HBox>
        </children>
    </GridPane>
    <Separator />
    <GridPane hgap="10.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="-Infinity" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <children>
            <Label fx:id="giveLabel" text="You give:" />
            <TextField fx:id="giveTextField" GridPane.columnIndex="1" />
            <Label fx:id="getLabel" text="You get:" GridPane.rowIndex="1" />
            <TextField fx:id="getTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label fx:id="commissionQuoteLabel" text="Commission (QUOTE):" GridPane.rowIndex="2" />
            <TextField fx:id="commissionQuoteTextField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label fx:id="commissionBaseLabel" text="Commission (BASE):" GridPane.rowIndex="3" />
            <TextField fx:id="commissionBaseTextField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        </children>
    </GridPane>
    <Label fx:id="hintLabel" wrapText="true" />
</fx:root>
